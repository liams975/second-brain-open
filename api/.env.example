# Absolute path to your vault directory.
VAULT_PATH=/Users/yourname/second-brain/obsidian-vault

# For the daily briefing and /api/insights.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

PORT=3001

# IANA timezone your daily files are named in. Daily notes are keyed to a local
# calendar day, so this must match whatever writes them.
TIMEZONE=UTC

# Where the briefing's weather is fetched for. Defaults to 0,0 — set these or
# the weather panel is useless.
LATITUDE=0
LONGITUDE=0

# Optional. Absolute path to a script that pulls from a wearable and writes
# data/ring/<date>.json. Leave unset if you have no local ingester; the Ring
# tab then reports that rather than failing. See docs/ring-schema.md.
RING_SYNC_SCRIPT=
